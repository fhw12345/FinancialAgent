# Common, non-secret application defaults
# This file IS committed to git

# CORS (local dev default, override in production)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Cache settings
REDIS_TTL_SECONDS=3600

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# LangSmith configuration
LANGSMITH_TRACING_V2=true
LANGSMITH_PROJECT=financial-agent

# LLM provider: maestro | anthropic | copilot_reverse
LLM_PROVIDER=maestro

# Agent Maestro defaults
MAESTRO_BASE_URL=http://localhost:23333/api/anthropic
MAESTRO_AUTH_TOKEN=Powered by Agent Maestro

# Direct Anthropic API (required only when LLM_PROVIDER=anthropic)
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# GitHub Copilot reverse proxy, served by ../copilot-bridge
COPILOT_REVERSE_BASE_URL=http://localhost:8765/cc
COPILOT_REVERSE_AUTH_TOKEN=dummy
COPILOT_REVERSE_MODEL=

# Per-role model assignments — top-of-line per vendor, cross-vendor preserved
# for adversarial debate diversity. Override here to experiment.
#
# — Latest Anthropic models
MODEL_DEEP_PLANNER=claude-opus-4.8
MODEL_REACT_AGENT=claude-sonnet-5
MODEL_PORTFOLIO_DECISIONS=claude-opus-4.8
MODEL_VERDICT=claude-opus-4.8
MODEL_SUB_TECHNICAL=claude-sonnet-5
MODEL_SIMPLE_CHAT=claude-haiku-4.5
# — GPT-5.6 Sol for structured financial extraction
MODEL_SUB_FINANCIAL=gpt-5.6-sol
MODEL_PORTFOLIO_RESEARCH=gpt-5.6-sol
# — Gemini for cross-vendor debate and fast news/summary work
MODEL_SUB_DEBATER=gemini-3.1-pro-preview
MODEL_SUB_NEWS=gemini-3.5-flash
MODEL_SUMMARY=gemini-3.5-flash
MODEL_ROUTER=claude-haiku-4.5

# Deep-research symbol resolution. Disable for deterministic offline E2E runs.
SYMBOL_RESOLUTION_LLM_ENABLED=true
