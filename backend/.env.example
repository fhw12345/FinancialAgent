# Backend env template - copy to backend/.env.development for local overrides
# Most settings live in backend/.env.base (committed). This file shows the
# secrets / overrides you may need.

# === Environment ===
ENVIRONMENT=development
LOG_LEVEL=INFO

# === Database ===
MONGODB_URL=mongodb://mongodb:27017/financial_agent
REDIS_URL=redis://redis:6379/0

# === LLM provider ===
# maestro | anthropic | copilot_reverse
LLM_PROVIDER=maestro

# Agent Maestro
MAESTRO_BASE_URL=http://host.docker.internal:23333/api/anthropic
MAESTRO_AUTH_TOKEN=Powered by Agent Maestro

# Direct Anthropic API
# Required when LLM_PROVIDER=anthropic. The same model is used for all roles.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# GitHub Copilot reverse proxy from ../copilot-bridge
# Local backend: http://localhost:8765/cc
# Docker backend: http://host.docker.internal:8765/cc
COPILOT_REVERSE_BASE_URL=http://host.docker.internal:8765/cc
COPILOT_REVERSE_AUTH_TOKEN=dummy
# Empty uses role defaults; set one model to force every role onto it.
COPILOT_REVERSE_MODEL=

# === Agent Maestro per-role model assignments ===
# Claude (deep reasoning / tool orchestration / chat)
MODEL_DEEP_PLANNER=claude-opus-4.8
MODEL_REACT_AGENT=claude-sonnet-5
MODEL_PORTFOLIO_DECISIONS=claude-opus-4.8
MODEL_VERDICT=claude-opus-4.8
MODEL_SUB_TECHNICAL=claude-sonnet-5
MODEL_SIMPLE_CHAT=claude-haiku-4.5
# GPT (structured financial extraction)
MODEL_SUB_FINANCIAL=gpt-5.6-sol
MODEL_PORTFOLIO_RESEARCH=gpt-5.6-sol
# Gemini (cross-vendor debater + fast news/summary)
MODEL_SUB_DEBATER=gemini-3.1-pro-preview
MODEL_SUB_NEWS=gemini-3.5-flash
MODEL_SUMMARY=gemini-3.5-flash
MODEL_ROUTER=claude-haiku-4.5

# Disable only for deterministic offline symbol-resolution testing.
SYMBOL_RESOLUTION_LLM_ENABLED=true

# === Optional: paid data sources (yfinance is the free default) ===
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
EXA_API_KEY=
FINNHUB_API_KEY=

# === Optional: observability ===
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# === App ===
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
